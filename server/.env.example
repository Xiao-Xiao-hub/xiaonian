# Node.js 24. npm run dev/start reads server/.env; dev-local scripts ignore it.
# Copy only when .env does not already exist. Never commit your real .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8788
LOG_LEVEL=info
DATABASE_PATH=./data/app.sqlite
UPLOAD_DIR=./data/uploads
FORMULA_DIR=./data/formulas
DEV_LOGIN_ENABLED=true
SESSION_TTL_SECONDS=604800
LEGACY_NOTES_READ_ONLY=false

# Optional admin access: leave unset to keep it disabled.
# Generate your own random value: openssl rand -hex 32
# ADMIN_API_KEY=
# Exact origin, with no path or trailing slash. HTTPS is required in production.
# ADMIN_ORIGIN=http://127.0.0.1:8788
# Use loopback only with a trusted same-host proxy that overwrites forwarding headers.
TRUST_PROXY=none

# WeChat credentials belong to your own application; secrets stay server-side.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
WECHAT_HTTP_TIMEOUT_MS=8000

# Server-only virtual payment credentials; leave unset until deployment approval.
# Personal direct goods use env=0. Never put AppKey/session_key in the client.
# WECHAT_VIRTUAL_OFFER_ID=
# WECHAT_VIRTUAL_APP_KEY=
# WECHAT_VIRTUAL_CALLBACK_TOKEN=
# WECHAT_VIRTUAL_CALLBACK_AES_KEY=
# WECHAT_VIRTUAL_CALLBACK_FORMAT=json
# WECHAT_VIRTUAL_CALLBACK_MODE=secure

JOB_CONCURRENCY=2
# Current learner budgets, estimated from successful usage and configured prices.
DAILY_BUDGET_CNY=3
WEEKLY_BUDGET_CNY=12
DAILY_SAFETY_CAP=500
# Compatibility defaults for usage categories; the budget above is the primary limit.
DAILY_AI_LIMIT=200
DAILY_OCR_LIMIT=60
DAILY_NOTES_LIMIT=30
CHAT_DAILY_LIMIT=60
PHOTO_DAILY_LIMIT=20
DAILY_BRAINSTORM_LIMIT=10
DAILY_IMPORT_LIMIT=10

# Generic chat-completions endpoint. These are placeholders, not a usable service.
# No API key means no authenticated external generation call.
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-id
LLM_EXTRA_BODY={}
# LLM_API_KEY=
LLM_TIMEOUT_MS=90000
# These fields only seed initial endpoints. Edit existing endpoints in /admin/.
# OCR_VISION_MODEL=your-vision-model-id

# Judgment adapter variables retain their established protocol names.
# JEV_API_KEY=
# JEV_BASE_URL=https://judge.example.com
# jev: judgment endpoint; llm: chat endpoint; jev_llm: judgment, then chat fallback.
JUDGE_PROVIDER=jev
JEV_TIMEOUT_MS=15000

# Optional dedicated OCR service. Keep both keys unset unless configured.
# TENCENT_SECRET_ID=your_secret_id
# TENCENT_SECRET_KEY=your_secret_key
OCR_REGION=ap-guangzhou
OCR_TIMEOUT_MS=20000

# Production requires DEV_LOGIN_ENABLED=false, real WeChat credentials, your own
# random ADMIN_API_KEY, HTTPS ADMIN_ORIGIN and an explicit persistent database.
# Existing Compose port mapping and health checks use PORT=8787, not local 8788.
# Complete the legal documents and platform settings before a real deployment.

# Eligible support tickets only; never send a startup/test email automatically.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=operator@example.com
# Recipient for eligible support-ticket notifications.
# SUPPORT_OPERATIONS_EMAIL=xiaonian-live@foxmail.com
# All four subscription values come from the operator's approved WeChat template.
# WECHAT_SUPPORT_SUBSCRIBE_TEMPLATE_ID=
# WECHAT_SUPPORT_SUBSCRIBE_TITLE_FIELD=thing1
# WECHAT_SUPPORT_SUBSCRIBE_STATUS_FIELD=phrase2
# WECHAT_SUPPORT_SUBSCRIBE_TIME_FIELD=time3
# Optional override: developer / trial / formal. Defaults to formal in production, developer otherwise.
# WECHAT_SUPPORT_SUBSCRIBE_STATE=developer
