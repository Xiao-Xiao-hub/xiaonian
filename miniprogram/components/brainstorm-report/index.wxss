.report {
  margin-bottom: 20rpx;
  padding: 8rpx 28rpx 24rpx;
  border-radius: 26rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}
.report-section {
  padding-top: 18rpx;
}
.report-name {
  display: block;
  margin-bottom: 8rpx;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 700;
}
.report-item {
  padding: 8rpx 0;
}
.report-text {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
}
.report-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}
.report-cards text {
  max-width: 300rpx;
  overflow: hidden;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--chip);
  color: var(--pencil);
  font-size: 22rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* V4.2 G9: no text under 24rpx (app.wxss floor). */
.report-cards text {
  font-size: 24rpx;
}
