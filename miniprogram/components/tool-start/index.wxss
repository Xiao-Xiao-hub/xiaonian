/* The four tools share this card: white, rounded like the 学习 tiles. */
.ts { margin-top: 8rpx; padding: 32rpx 28rpx 28rpx; border-radius: 36rpx; background: var(--card); box-shadow: var(--shadow); }
.ts-head { display: flex; align-items: center; gap: 20rpx; }
.ts-copy { flex: 1; min-width: 0; }
.ts-t { display: block; font-size: 40rpx; font-weight: 700; line-height: 1.35; color: var(--ink); }
.ts-s { display: block; margin-top: 6rpx; font-size: 26rpx; line-height: 1.5; color: var(--sub); }
.ts-ic { flex: none; width: 120rpx; height: 120rpx; }
.ts-acts { display: flex; gap: 20rpx; margin-top: 32rpx; }
.ts-btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 12rpx; width: auto !important; min-height: 96rpx; border: 2rpx solid var(--rule-2); border-radius: var(--radius-btn); background: var(--card); color: var(--ink); font-size: 30rpx; font-weight: 600; }
.ts-btn.main { border-color: var(--primary-fill); background: var(--primary-fill); color: var(--on-primary); box-shadow: var(--btn-shadow); }
.ts-i { width: 36rpx; height: 36rpx; }
