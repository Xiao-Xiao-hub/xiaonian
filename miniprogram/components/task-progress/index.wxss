.tp { margin-top: 24rpx; padding: 28rpx 28rpx 24rpx; border-radius: 24rpx; background: var(--card); box-shadow: var(--shadow); }
.tp-steps { display: flex; flex-direction: column; gap: 18rpx; }
.tp-step { display: flex; align-items: center; gap: 18rpx; min-height: 40rpx; color: var(--faint); font-size: 27rpx; line-height: 1.4; }
.tp-dot { position: relative; flex: none; width: 30rpx; height: 30rpx; border: 2rpx solid var(--rule-2); border-radius: 50%; background: var(--card); box-sizing: border-box; }
.tp-step.done { color: var(--pencil); }
.tp-step.done .tp-dot { border-color: var(--primary); background: var(--primary); }
.tp-step.done .tp-dot::after { content: ""; position: absolute; left: 9rpx; top: 4rpx; width: 7rpx; height: 13rpx; border: solid #ffffff; border-width: 0 3rpx 3rpx 0; transform: rotate(45deg); }
.tp-step.now { color: var(--ink); font-weight: 600; }
.tp-step.now .tp-dot { border-color: var(--primary-soft); background: var(--primary-wash); }
.tp-step.now .tp-dot::after { content: ""; position: absolute; left: 7rpx; top: 7rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); animation: tp-breathe 1.6s ease-in-out infinite; }
.tp-step.stop { color: var(--ink); }
.tp-step.stop .tp-dot { border-color: var(--red-soft); background: var(--red-wash); }
.tp-step.stop .tp-dot::after { content: ""; position: absolute; left: 8rpx; top: 8rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--red); }
.tp-label { flex: none; }
.tp-note { margin-left: auto; color: var(--pencil); font-size: 24rpx; font-weight: 400; }
.tp-prg { margin-top: 26rpx; }
.tp-prg .val { transition: width 0.6s ease-out; }
.tp-failed .tp-prg .val { background: var(--rule-2); }
.tp-time { display: block; margin-top: 12rpx; color: var(--pencil); font-size: 24rpx; }
.tp-slow { display: block; margin-top: 8rpx; color: var(--pencil); font-size: 24rpx; line-height: 1.55; }
.tp-fail { display: flex; align-items: center; gap: 20rpx; margin-top: 20rpx; }
.tp-msg { flex: 1; min-width: 0; color: var(--red-ink); font-size: 26rpx; line-height: 1.5; }
.tp-retry { flex: none; min-height: 88rpx !important; margin: 0 !important; }
.tp-leave { display: block; min-height: 88rpx; margin-top: 4rpx; color: var(--link); font-size: 26rpx; line-height: 88rpx; text-align: center; }
@keyframes tp-breathe { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.45; transform: scale(0.8); } }
