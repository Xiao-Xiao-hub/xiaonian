<view class="page chat-page" style="padding-bottom:calc(220rpx + {{kb}}px)" capture-bind:touchstart="studyTouch">
  <view wx:if="{{!consent}}" class="empty"><text class="h3">游客模式不能聊</text><text>同意用户协议和隐私政策后就能聊了。</text><button class="btn" hover-class="btn-press" bindtap="agree">去同意</button></view>
  <block wx:else>
    <view class="head"><text class="ai-line">AI 生成可能有误，注意核实</text><view wx:if="{{!loading && (thread || !sending)}}" class="more tap-area" hover-class="pressed" bindtap="more" aria-role="button" aria-label="更多">⋯</view></view>
    <chat-panel wx:if="{{thread}}" part="header" thread="{{thread}}" messages="{{messages}}" scene-candidate="{{sceneCandidate}}" break-reminder="{{breakReminder}}" bindremovecard="removecard" bindmoodaccept="moodaccept" bindmooddecline="mooddecline"/>
    <view wx:if="{{!messages.length}}" class="start"><text wx:if="{{loading}}" class="hint">打开中…</text><block wx:else><text class="start-title">{{thread && thread.mode === 'teach' ? '想讲讲什么？' : '想聊点什么？'}}</text><text class="start-lede">{{thread && thread.mode === 'teach' ? '用你自己的话讲一遍。' : thread && thread.currentCards.length ? '卡带上了，直接打字就行。' : '随便说说就好，慢慢来。'}}</text></block></view>
    <chat-panel part="messages" compact="{{true}}" thread="{{thread}}" messages="{{messages}}" bindcollect="collect" bindmistake="mistake" bindspot="spot" bindteachsave="teachsave" bindteachchange="teachchange" bindteachpick="teachpick" bindattachmore="attachmore"/>
    <chat-panel wx:if="{{suggestions.length}}" part="related" thread="{{thread}}" suggestions="{{suggestions}}" bindsuggestadd="suggestadd" bindsuggestdismiss="suggestdismiss"/>
    <chat-panel part="actions" thread="{{thread}}" actions="{{actions}}" sending="{{sending || busy !== ''}}" bindaction="panelAction"/>
    <view wx:if="{{thread && thread.wrapReady && !busy && !sending}}" class="wrap-ready" hover-class="pressed" bindtap="openWrap">理好的卡还没存<text class="go">去看看 ›</text></view>
    <text wx:if="{{busy === 'wrap'}}" class="hint working">在帮你理一理，理好了就能存成卡…{{wrapWait >= 10 ? '已等 ' + wrapWait + ' 秒，聊得多会慢一点' : ''}}</text>
    <text wx:if="{{notice}}" class="notice">{{notice}}</text>
    <text wx:if="{{error}}" class="error">{{error}}</text>
    <view wx:if="{{pending.length}}" class="tray-room"/>
    <view class="composer {{kb ? 'kb-up' : ''}}" style="bottom:{{kb}}px">
      <chat-attach wx:if="{{pending.length}}" class="tray" items="{{pending}}" removable="{{true}}" bindremove="unpend" bindretry="retryattach"/>
      <view class="row"><view class="plus tap-area" hover-class="pressed" bindtap="plus" aria-role="button" aria-label="添加图片或文件"><image class="plus-icon" src="/assets/icons/plus-ink.png"/></view><textarea class="input" fixed auto-height disable-default-padding maxlength="2000" cursor-spacing="28" adjust-position="{{false}}" show-confirm-bar="{{false}}" confirm-type="send" placeholder="{{thread && thread.mode === 'teach' ? '讲讲你的理解' : messages.length ? '接着说…' : '说点什么……'}}" placeholder-class="placeholder" value="{{draft}}" focus="{{focus}}" bindinput="input" bindblur="blur" bindkeyboardheightchange="keyboardHeight" bindconfirm="submit"/><view class="send tap-area {{(draft || pending.length) && !sending ? 'on' : ''}}" hover-class="btn-press" bindtap="submit" aria-role="button" aria-label="发送"><image class="icon" src="/assets/icons/send-white.png"/></view></view>
    </view>
  </block>
</view>
