.note-heading { word-break: break-all; }
.original { margin-top: 18rpx; padding: 30rpx; background: var(--note-wash); border-radius: 6rpx 28rpx 28rpx 28rpx; }
.original-label { display: block; margin-bottom: 24rpx; color: var(--note-ink); font-size: 24rpx; }
.original-text { display: block; white-space: pre-wrap; word-break: break-all; font-size: 30rpx; line-height: 1.9; color: var(--ink); }
.title-editor { padding: 28rpx; }
.title-input { margin: 24rpx 0; padding: 16rpx; min-height: 88rpx; border: 2rpx solid var(--rule-2); border-radius: var(--radius-s); color: var(--ink); font-size: 30rpx; }
.actions { display: flex; gap: 16rpx; }
.actions button { flex: 1; width: auto !important; margin: 0; }
.form-error { display: block; color: var(--red-ink); font-size: 26rpx; margin-bottom: 20rpx; }
.page .danger { color: var(--red-ink) !important; }
.text-action { width: auto !important; min-width: 88rpx; margin: 0; padding: 20rpx 8rpx; min-height: 88rpx; line-height: 48rpx; background: transparent; color: var(--link); font-size: 26rpx; }
.text-action::after { border: none; }
.head-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.head-copy { flex: 1; min-width: 0; }
.usage-line { margin-top: 16rpx; }
.notice { display: block; padding: 20rpx; margin-bottom: 20rpx; border-radius: 12rpx; color: var(--mint-ink); background: var(--mint-wash); font-size: 26rpx; line-height: 1.7; }
.small-label { display: block; color: var(--pencil); font-size: 24rpx; line-height: 1.6; }
.plain-text { display: block; white-space: pre-wrap; word-break: break-all; color: var(--ink); font-size: 29rpx; line-height: 1.85; }
.supplements { margin: 0 16rpx; }
.supplement-entry { padding: 26rpx 12rpx; border-bottom: 2rpx dashed var(--rule-2); }
.supplement-entry .plain-text { margin-top: 10rpx; }
.job-note, .stale-note { margin-top: 20rpx; padding: 24rpx; border-radius: 16rpx; font-size: 27rpx; line-height: 1.75; background: var(--ai-wash); color: var(--ai-ink); }
.stale-note { background: var(--amber-wash); color: var(--amber-ink); }
.organize-empty { padding: 24rpx 4rpx 8rpx; color: var(--pencil); font-size: 27rpx; line-height: 1.85; }
.outline-group { margin-top: 24rpx; padding: 28rpx; border: 2rpx solid var(--line); border-radius: 20rpx; background: var(--card); box-shadow: var(--shadow); }
.group-head { display: flex; gap: 12rpx; align-items: center; }
.group-name { font-size: 32rpx; font-weight: 650; color: var(--ink); }
.group-hint, .empty-group { display: block; color: var(--pencil); font-size: 25rpx; line-height: 1.75; margin-top: 10rpx; }
.empty-group { margin-top: 22rpx; }
.outline-item { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid var(--rule); }
.item-actions { display: flex; flex-wrap: wrap; gap: 8rpx 30rpx; }
.edited-mark { display: block; margin-top: 6rpx; color: var(--pencil); font-size: 24rpx; }
.item-editor { padding-top: 12rpx; }
.group-picker { display: flex; justify-content: space-between; padding: 20rpx 16rpx; border: 2rpx solid var(--rule-2); border-radius: 12rpx; font-size: 27rpx; color: var(--ink); }
.group-picker text { color: var(--link); }
.item-input { min-height: 180rpx; margin: 16rpx 0; }
.question-note { margin-top: 28rpx; padding: 30rpx; border-radius: 8rpx 24rpx 24rpx 24rpx; background: var(--ai-wash); border: 2rpx solid var(--line); }
.question-note .small-label { color: var(--ai-ink); }
.question-text { display: block; font-size: 31rpx; line-height: 1.75; color: var(--ink); margin: 16rpx 0 22rpx; }
.answer-option { width: 100% !important; margin: 14rpx 0 0; padding: 20rpx 24rpx; min-height: 88rpx; border: 2rpx solid var(--rule-2); border-radius: 14rpx; font-size: 28rpx; line-height: 1.65; text-align: left; background: var(--card); color: var(--ink); }
.answer-option::after { border: none; }
.supplement-compose { padding: 28rpx; }
.supplement-input { margin-top: 20rpx; min-height: 180rpx; }
.supplement-foot { margin-top: 18rpx; }
.supplement-foot .btn-line { margin-top: 16rpx; }
.organize-actions { margin-top: 24rpx; }
.next-step { padding: 28rpx; margin-top: 32rpx; background: var(--mint-wash); border: 2rpx solid var(--line); border-radius: 20rpx; }
.next-step .small-label { color: var(--mint-ink); margin-bottom: 14rpx; }
.point-link { padding: 28rpx; margin-top: 24rpx; border: 2rpx dashed var(--rule-2); border-radius: 20rpx; background: var(--card); }
.point-link.linked { border-style: solid; }
.point-name { display: block; margin-top: 12rpx; font-size: 31rpx; line-height: 1.6; color: var(--ink); }
.read-only { display: block; margin-top: 24rpx; }
