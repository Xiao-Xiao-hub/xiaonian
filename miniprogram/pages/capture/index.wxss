.drop { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 380rpx; background: var(--card); border: 2rpx dashed var(--rule-2); border-radius: var(--radius); }
.drop-icon { width: 64rpx; height: 64rpx; }
.drop-title { margin-top: 22rpx; font-size: 30rpx; font-weight: 600; }
.drop-sub { margin-top: 4rpx; font-size: 24rpx; color: var(--pencil); }
.frame { padding: 16rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
.preview { display: block; width: 100%; height: 440rpx; }
.frame-actions { display: flex; justify-content: flex-end; gap: 48rpx; margin-top: 18rpx; }
.tip-line { margin-top: 24rpx; }
.import-link { display: block; margin-top: 20rpx; padding: 12rpx 0; font-size: 26rpx; text-align: center; }
