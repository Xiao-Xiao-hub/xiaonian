.page { padding:24rpx 32rpx; }.ai-line { text-align:center; color:var(--pencil); font-size:24rpx; margin-bottom:20rpx; }.row { display:flex; align-items:center; gap:20rpx; background:var(--card); border:2rpx solid var(--line); border-radius:24rpx; padding:24rpx 20rpx 24rpx 28rpx; margin-bottom:20rpx; }.content { flex:1; min-width:0; }.title { color:var(--ink); font-size:30rpx; line-height:1.5; font-weight:600; }.question { display:block; margin-top:6rpx; color:var(--body); font-size:26rpx; line-height:1.5; }.meta { margin-top:8rpx; color:var(--pencil); font-size:24rpx; }.ai-dot { color:var(--violet); font-size:24rpx; }.link { flex:none; color:var(--primary); background:transparent; padding:8rpx 12rpx; margin:0; font-size:26rpx; text-align:center; }.link::after { border:0; }.dots { font-weight:700; }.dots::after { border:0; }.empty { display:block; color:var(--pencil); font-size:28rpx; text-align:center; padding:50rpx 0; }.error { color:var(--red); font-size:26rpx; }
