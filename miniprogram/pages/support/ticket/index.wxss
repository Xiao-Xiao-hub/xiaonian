@import "../chat/index.wxss";
.ticket-card { margin-top:22rpx; padding:26rpx; border-radius:24rpx; background:var(--card); box-shadow:0 8rpx 22rpx rgba(44,107,188,.08); }.ticket-top { display:flex; justify-content:space-between; color:var(--primary); font-size:26rpx; }.ticket-content { margin:18rpx 0; white-space:pre-wrap; line-height:1.6; }.reply { margin-top:18rpx; padding-top:18rpx; border-top:1rpx solid var(--rule); font-size:28rpx; line-height:1.6; }

.ticket-top { gap: 20rpx; align-items: flex-start; }.ticket-input { width:100%; min-height:180rpx; margin:18rpx 0; padding:18rpx; box-sizing:border-box; border:1rpx solid var(--line); border-radius:16rpx; background:var(--card); }.ticket-content,.reply { word-break: break-word; }
