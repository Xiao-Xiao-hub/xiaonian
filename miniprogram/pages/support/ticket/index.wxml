<view class="support-page"><view wx:if="{{loading}}" class="empty">正在读取工单…</view><view wx:elif="{{error}}" class="error">{{error}}</view><view wx:if="{{turnId && !ticket}}" class="composer"><view class="hero-title">确认提交人工工单</view><view class="hint">提交后会在三天内处理，你可以在这里查看进度与回复。</view><textarea class="ticket-input" value="{{content}}" maxlength="2000" placeholder="补充说明" bindinput="input"/><button class="primary" loading="{{submitting}}" disabled="{{submitting || confirming}}" bindtap="submit">确认提交</button></view><view wx:if="{{ticket}}" class="ticket-card"><view class="ticket-top"><text>{{ticket.statusText}}</text></view><view class="ticket-content">{{ticket.content}}</view><view wx:if="{{!ticket.replies.length}}" class="hint">尚未收到回复，请稍后在此查看处理进度。</view><view wx:for="{{ticket.replies}}" wx:key="id" class="reply"><view>{{item.content}}</view><view class="hint">{{item.dateLabel}}</view></view></view></view>
