<view class="support-page"><view wx:if="{{loading}}" class="empty">正在读取工单…</view><view wx:elif="{{error}}" class="empty"><view>{{error}}</view><button class="secondary" bindtap="load">重新尝试</button></view><view wx:elif="{{!tickets.length}}" class="empty">还没有工单。</view><view wx:else class="ticket-list"><view wx:for="{{tickets}}" wx:key="id" class="ticket-card" data-id="{{item.id}}" bindtap="open"><view class="ticket-top"><text>{{item.statusText}}</text><text>{{item.dateLabel}}</text></view><view class="ticket-content">{{item.content}}</view></view></view></view>
