.support-page { min-height: 100vh; padding: 28rpx 28rpx 48rpx; background: var(--bg); color: var(--ink); box-sizing: border-box; }
.support-hero, .composer, .turns, .empty { background: var(--card); border-radius: 32rpx; box-shadow: 0 10rpx 28rpx rgba(44, 107, 188, .08); }
.support-hero { display: flex; gap: 18rpx; padding: 28rpx; align-items: center; }
.mascot { width: 96rpx; height: 96rpx; flex: none; }.hint { font-size: 24rpx; color: var(--sub); }.hero-title { margin-top: 4rpx; font-size: 36rpx; font-weight: 700; }.hero-note { margin-top: 8rpx; font-size: 26rpx; line-height: 1.6; color: var(--body); }
.turns { margin-top: 22rpx; padding: 22rpx; }.turn + .turn { margin-top: 26rpx; }.bubble { padding: 18rpx 20rpx; border-radius: 24rpx; font-size: 28rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }.mine { margin-left: 80rpx; background: var(--primary); color: var(--on-primary); }.answer { margin-top: 12rpx; background: var(--primary-wash); color: var(--body); }
.composer { margin-top: 22rpx; padding: 18rpx; }.composer textarea { width: 100%; height: 180rpx; font-size: 28rpx; box-sizing: border-box; }.compose-foot { display:flex; align-items:center; justify-content:space-between; color:var(--sub); font-size:24rpx; }.primary,.secondary,.orders-link,.text-action { width:auto !important; min-width:0; font-size: 26rpx; border-radius: 24rpx; }.primary { margin:0; padding:0 28rpx; background:var(--primary); color:var(--on-primary); }.secondary,.orders-link { margin-top:22rpx; padding:0 28rpx; background:var(--card); color:var(--primary); }.text-action { margin: 12rpx 0 0; padding: 0; background: transparent; color: var(--primary); text-align:left; }.text-action::after { border:0; }.empty { margin-top:22rpx; padding:48rpx 28rpx; text-align:center; line-height:1.8; }.error { margin-top:20rpx; padding:18rpx; border-radius:20rpx; background:var(--red-wash); color:var(--red-ink); font-size:26rpx; }
.faq { margin-top:22rpx; padding:24rpx; background:var(--card); border-radius:32rpx; box-shadow:0 10rpx 28rpx rgba(44,107,188,.08); }.faq-title { font-size:30rpx; font-weight:700; }.faq-item + .faq-item { border-top:1rpx solid var(--rule); }.faq-question { width:100% !important; margin:0; padding:20rpx 0; background:transparent; color:var(--body); font-size:28rpx; text-align:left; }.faq-question::after { border:0; }.faq-answer { padding:0 0 20rpx; color:var(--body); font-size:26rpx; line-height:1.7; white-space:pre-wrap; }
.primary,.secondary,.orders-link { display:flex; align-items:center; justify-content:center; min-height:76rpx; padding:16rpx 28rpx; line-height:1.3; text-align:center; }
.compose-foot .primary { flex:none; min-height:64rpx; margin:0; }

.primary[disabled] { background: var(--disabled); color: var(--on-primary); }
