/* 讲一遍 (V4.1 G5): the tool card, a big input for explaining, the result card. */
.tc-topic { display: flex; align-items: center; gap: 16rpx; margin-top: 28rpx; padding: 10rpx 10rpx 10rpx 24rpx; border-radius: 28rpx; background: var(--fill); }
.tc-in { flex: 1; min-width: 0; height: 72rpx; font-size: 28rpx; }
.tc-go { flex: none; width: 72rpx !important; height: 72rpx; border-radius: 50%; background: var(--disabled); color: var(--on-primary); font-size: 28rpx; font-weight: 700; line-height: 72rpx; text-align: center; }
.tc-go.on { background: var(--primary-fill); box-shadow: var(--btn-shadow); }
.sh { display: flex; align-items: center; margin: 36rpx 4rpx 16rpx; }
.sh-t { font-size: 32rpx; font-weight: 700; color: var(--ink); }
.tc-tabs { margin: 0 -32rpx 8rpx; padding: 0 32rpx; white-space: nowrap; }
.tc-tabs .chip { display: inline-flex; margin-right: 16rpx; }
.tc-head { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; border-radius: 36rpx; background: var(--card); box-shadow: var(--shadow); }
.tc-copy { flex: 1; min-width: 0; }
.tc-t { display: block; font-size: 36rpx; font-weight: 700; color: var(--ink); }
.tc-s { display: block; margin-top: 4rpx; font-size: 26rpx; color: var(--sub); }
.tc-empty { margin-top: 32rpx; font-size: 26rpx; line-height: 1.7; color: var(--sub); text-align: center; }
.tc-me { display: flex; justify-content: flex-end; margin-top: 28rpx; }
.tc-bubble { max-width: 84%; padding: 20rpx 26rpx; border-radius: 28rpx 8rpx 28rpx 28rpx; background: var(--primary-wash); font-size: 29rpx; }
.tc-xl { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 28rpx; }
.xl-av.sm { width: 56rpx; height: 56rpx; }
.tc-card { flex: 1; min-width: 0; padding: 22rpx 26rpx; border-radius: 8rpx 28rpx 28rpx 28rpx; background: var(--card); box-shadow: var(--shadow); font-size: 29rpx; line-height: 1.7; }
.tc-card.big { padding: 28rpx; border-radius: 36rpx; }
.tc-tail { display: block; white-space: pre-wrap; }
.tc-composer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--rule); background: var(--card); }
.tc-input { display: block; box-sizing: border-box; width: 100%; min-height: 168rpx; max-height: 360rpx; padding: 20rpx 24rpx; border-radius: 24rpx; background: var(--fill); font-size: 30rpx; line-height: 1.6; }
.tc-acts { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; margin-top: 14rpx; }
.tc-done { display: inline-flex; align-items: center; justify-content: center; width: auto !important; min-height: 72rpx; padding: 0 32rpx; border: 2rpx solid var(--rule-2); border-radius: var(--radius-btn); color: var(--faint); font-size: 28rpx; font-weight: 600; }
.tc-done.on { border-color: var(--primary-soft); color: var(--primary-ink); }
.tc-send { display: flex; align-items: center; justify-content: center; width: 80rpx !important; height: 80rpx; border-radius: 50%; background: var(--disabled); }
.tc-send.on { background: var(--primary-fill); box-shadow: var(--btn-shadow); }
.tc-send .icon { width: 38rpx; height: 38rpx; }
.tc-score { display: block; margin-top: 8rpx; font-size: 26rpx; color: var(--sub); }
.tc-group { margin-top: 28rpx; }
.tc-gt { display: block; margin-bottom: 8rpx; font-size: 28rpx; font-weight: 700; }
.tc-gt.green { color: var(--green-ink); }
.tc-gt.amber { color: var(--amber-ink); }
.tc-gt.red { color: var(--red-ink); }
.tc-pt { padding: 14rpx 0; border-top: 2rpx solid var(--rule); font-size: 28rpx; line-height: 1.7; }
.tc-row { display: flex; align-items: flex-start; gap: 12rpx; }
.tc-row .tag { margin-top: 6rpx; }
.tc-pt-t { flex: 1; min-width: 0; }
.tc-q { display: block; margin-top: 6rpx; padding-left: 16rpx; border-left: 6rpx solid var(--marker); font-size: 26rpx; color: var(--body); }
.tc-fix { margin-top: 8rpx; }
.tc-fk { display: block; font-size: 24rpx; font-weight: 600; color: var(--sub); }
.tc-best { margin-top: 28rpx; padding: 18rpx 22rpx; border-radius: var(--radius-s); background: var(--marker-wash); }
.tc-best-t { display: block; margin-top: 6rpx; font-size: 28rpx; line-height: 1.7; color: var(--ink); }
/* V4.2 G7: 继续刚才的讲解 and past ones, under the start. */
.tc-list { margin-top: 28rpx; }
.tc-past { display: flex; align-items: center; gap: 16rpx; min-height: 96rpx; padding: 16rpx 4rpx; border-bottom: 2rpx solid var(--rule); }
.tc-pt-name { display: block; font-size: 28rpx; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tc-go-r { flex: none; color: var(--faint); font-size: 30rpx; }

/* V4.2 G4: the low-budget line under the AI line. */
.usage {
  margin: -12rpx 0 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--sub);
}
.tc-wait { margin-top: 24rpx; }

/* V4.2 FX5b: 更早的记录 is a full row in the link colour (as on 错题本). */
.more-line { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin-top: 8rpx; font-size: 26rpx; color: var(--link); }
