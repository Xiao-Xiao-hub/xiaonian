<view class="page card-page" capture-bind:touchstart="studyTouch">
  <view wx:if="{{guestBlocked}}" class="empty"><view class="h3">同意后才能看自己的卡</view><text>游客模式只能看示例卡。</text><view class="gap-top"><button class="btn sm" bindtap="agree">去同意</button></view></view>
  <text wx:if="{{example}}" class="example-line">{{notice}}</text>
  <view class="ai-line">AI 生成可能有误，注意核实</view>
  <text wx:if="{{loading&&!card}}" class="empty">打开中…</text>
  <text wx:if="{{error&&!card}}" class="alert">{{error}}</text>
  <block wx:if="{{card}}">
    <view class="face t-{{card.typeClass}}">
      <view class="face-top"><view class="tl lg"><image class="tl-ic" src="{{card.typeIcon}}" mode="aspectFit"/><text>{{card.typeName}}</text></view><text wx:if="{{card.mood}}" class="mood">☾ 心情</text></view>
      <view class="face-title">{{card.titleView.text}}</view>
      <view class="face-tags"><text wx:for="{{card.tags}}" wx:key="id" class="tag" style="{{item.style}}">#{{item.name}}</text><text wx:if="{{!example}}" class="tag add" bindtap="toggleTagPanel">＋ 标签</text></view>
      <view wx:if="{{detail.progress.steps.length}}" class="pg">
        <view class="steps-row"><text wx:for="{{detail.progress.steps}}" wx:key="name" class="{{item.on ? 'on' : ''}}">{{item.name}}</text></view>
        <view wx:if="{{detail.progress.next}}" class="lb"><text>{{detail.progress.next}}</text></view>
      </view>
    </view>
    <view wx:if="{{tagPanel&&!example}}" class="tag-panel"><view class="tag-grid"><button wx:for="{{tagOptions}}" wx:key="id" class="tag-choice {{item.selected?'on':''}}" style="{{item.style}}" data-id="{{item.id}}" bindtap="toggleTag">{{item.selected?'✓ ':''}}#{{item.name}}</button></view><view class="panel-foot"><text>最多选 3 个</text><text class="link" bindtap="manageTags">编辑标签</text></view></view>
    <text wx:if="{{!example&&notice}}" class="hint working">{{notice}}</text><text wx:if="{{error}}" class="alert">{{error}}</text>

    <view wx:if="{{detail.asks.length}}" class="dblk ask"><view class="bh"><view class="dk dk-bulb"/><text>提问</text><text wx:if="{{detail.asks.length>1}}" class="act" bindtap="toggleAsks">{{asksOpen ? '收起' : (askAt + 1) + '/' + detail.asks.length}}</text></view><block wx:for="{{detail.asks}}" wx:key="id"><view wx:if="{{index===askAt||asksOpen}}" class="ask-item"><text class="ask-question"><text wx:if="{{item.ai}}" class="ai-dot">•</text>{{item.text}}</text><block wx:if="{{!example}}"><view wx:if="{{answering===item.id}}" class="ask-answer"><view wx:if="{{item.options.length}}" class="ask-options"><button wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" class="ask-option" data-kind="followup" data-action="answer" data-text="{{option}}" bindtap="answer"><text class="ai-dot">•</text>{{option}}</button></view><textarea class="answer-field" auto-height focus value="{{answerDrafts[item.id]}}" data-id="{{item.id}}" maxlength="300" bindinput="answerInput" placeholder="{{item.kind==='open'?'想到什么了？写一句，也可以不写':'写一句你的想法'}}"/><view class="ask-actions end"><button class="btn-text" bindtap="cancelAnswer">算了</button><button class="btn-soft sm ask-btn" loading="{{busy}}" data-kind="{{item.kind}}" data-key="{{item.kind==='open'?item.key:''}}" data-action="{{item.kind==='open'?'done':'answer'}}" bindtap="answer">好了</button></view></view><view wx:else class="ask-actions"><button class="btn-soft sm ask-btn" data-id="{{item.id}}" bindtap="startAnswer">回答</button><button class="btn-text" data-kind="{{item.kind}}" data-key="{{item.kind==='open'?item.key:''}}" data-action="thinking" bindtap="answer">下一个</button></view></block></view></block></view>

    <view class="dblk said"><view class="bh"><view class="dk dk-edit"/><text>我的话</text><text wx:if="{{card.mine&&!mineEditing&&!example}}" class="act" bindtap="editMine">编辑</text></view><view wx:if="{{mineEditing}}"><textarea class="mine-field" auto-height focus value="{{mineDraft}}" bindinput="mineInput" maxlength="300" placeholder="用你自己的话，说说现在怎么想"/><view class="inline-actions"><button wx:if="{{card.mine}}" class="btn-text danger" bindtap="clearMine">删掉</button><button class="btn-text" bindtap="cancelMine">算了</button><button class="btn sm" loading="{{busy}}" bindtap="saveMine">存下</button></view></view><block wx:elif="{{card.mine}}"><text class="say">{{card.mine}}</text><view wx:if="{{detail.previousMine}}" class="mine-trail"><text>{{detail.previousMine.date}} 我以为：{{detail.previousMine.data.text}}</text><text>→ {{detail.mineDate}} 现在：{{card.mine}}</text></view></block><text wx:elif="{{!example}}" class="empty-line" bindtap="editMine">用你自己的话说一句 ›</text><text wx:else class="hint">还没写</text></view>

    <view class="dblk tidy"><view class="bh"><view class="dk dk-file"/><text>整理</text><text wx:if="{{!example}}" class="act" bindtap="openEditor">编辑</text></view><view wx:if="{{detail.hasTidy}}" class="tidy-body"><view wx:if="{{card.summary}}" class="tidy-sum"><text wx:if="{{card.summaryBy!=='user'}}" class="ai-dot">•</text><rich blocks="{{detail.summaryBlocks}}"/></view><view wx:for="{{detail.tidyRows}}" wx:key="key" class="tidy-li"><text class="n">{{index + 1}}</text><view class="tidy-tx"><text wx:if="{{item.label}}" class="em">{{item.label}}</text><rich blocks="{{item.blocks}}"/></view></view><text wx:if="{{card.next}}" class="tidy-next"><text wx:if="{{card.next.by!=='user'}}" class="ai-dot">•</text>如果{{card.next.if}}，就{{card.next.then}}<text wx:if="{{card.next.on}}">（{{card.next.on}}）</text></text></view><text wx:else class="hint">还没整理</text><view wx:if="{{detail.tidyFailed&&!busy&&!example}}" class="tidy-retry"><text>上次没理好</text><text class="link" bindtap="tidy">再理一遍</text></view><view wx:if="{{card.quote}}" class="quote" bindtap="openSource"><view class="dk dk-quote"/><text>原话：{{card.quote}}</text></view></view>

    <view class="dblk more"><view class="bh"><view class="dk dk-plus"/><text>补充</text><text wx:if="{{!supplementOpen&&!example}}" class="act" bindtap="openSupplement">添加</text></view><view wx:if="{{detail.supplements.length}}" class="tline"><view wx:for="{{detail.supplements}}" wx:key="index" class="ti"><text class="d">{{item.date}}</text><text class="p"><text wx:if="{{item.ai}}" class="ai-dot">•</text>{{item.text}}</text></view></view><block wx:if="{{supplementOpen}}"><textarea class="mine-field supplement-field" auto-height focus value="{{supplementDraft}}" bindinput="supplementInput" maxlength="500" placeholder="又想到什么，补一句"/><view class="inline-actions"><button class="btn-text" bindtap="cancelSupplement">算了</button><button class="btn sm" loading="{{busy}}" bindtap="saveSupplement">存下</button></view></block><text wx:if="{{!detail.supplements.length&&!supplementOpen}}" class="hint">还没有</text></view>

    <text class="sh2">详情</text>
    <view class="rows info">
      <view wx:if="{{card.pointId}}" class="item" bindtap="openPoint"><text class="title">知识点</text><text class="v blue">{{detail.pointName}}</text><text class="chevron">›</text></view>
      <view class="item" bindtap="toggleLinks"><text class="title">关联卡片</text><text class="v">{{detail.links.length ? detail.links.length + ' 张' : '还没有'}}</text><text class="chevron">{{linksOpen ? '⌃' : '›'}}</text></view>
      <view wx:if="{{linksOpen}}" class="sub-list"><view wx:for="{{detail.links}}" wx:key="id" class="linked-card"><text class="linked-title" data-id="{{item.id}}" bindtap="openLinked">{{item.typeName}} · {{item.titleView.text}} ›</text><button wx:if="{{!example}}" class="btn-text quiet-btn" data-id="{{item.id}}" bindtap="unlink">不关联了</button></view><button wx:if="{{!example}}" class="btn-text" bindtap="link">＋ 关联一张卡</button></view>
      <view wx:if="{{detail.mergedFrom.length}}" class="item" bindtap="toggleMerged"><text class="title">合并自</text><text class="v">{{detail.mergedFrom.length}} 张</text><text class="chevron">{{mergedOpen ? '⌃' : '›'}}</text></view>
      <view wx:if="{{mergedOpen}}" class="sub-list"><view wx:for="{{detail.mergedFrom}}" wx:key="id" class="linked-card"><text class="linked-title" data-id="{{item.id}}" bindtap="openOriginal">{{item.typeName}} · {{item.titleView.text}} ›</text></view><button wx:if="{{!example && detail.version === 1}}" class="btn-text" bindtap="unmerge">拆开</button></view>
      <view wx:if="{{!example}}" class="item"><text class="title">之后</text><view class="every follow"><text wx:for="{{follows}}" wx:key="id" class="{{detail.follow===item.id ? 'on' : ''}}" data-follow="{{item.id}}" bindtap="setFollow">{{item.name}}</text></view></view>
      <view class="item"><text class="title">提醒</text><picker wx:if="{{!example}}" class="v-picker" mode="date" start="{{today}}" end="{{lastDay}}" value="{{detail.remindOn||today}}" bindchange="remindChange"><text class="v">{{detail.remindText}}</text></picker><text wx:else class="v">{{detail.remindText}}</text><text wx:if="{{detail.remindOn&&!example}}" class="link clear" bindtap="clearRemind">不提醒</text><text class="chevron">›</text></view>
      <view wx:if="{{!example}}" class="item"><text class="title">重复</text><view class="every"><text class="{{detail.remindEvery==='day' ? 'on' : ''}}" data-every="day" bindtap="saveEvery">每天</text><text class="{{detail.remindEvery==='week' ? 'on' : ''}}" data-every="week" bindtap="saveEvery">每周</text><text wx:if="{{detail.remindEvery}}" data-every="" bindtap="saveEvery">关掉</text></view></view>
      <view class="item" bindtap="openSource"><text class="title">来源</text><text class="v">{{detail.sourceName}} · {{card.sceneName}}</text></view>
      <view class="item" bindtap="toggleInfo"><text class="title">更多记录</text><text class="chevron">{{infoOpen ? '⌃' : '›'}}</text></view>
    </view>
    <view wx:if="{{infoOpen}}" class="content-box fact-list"><view wx:if="{{detail.retestText}}" class="fact-row">{{detail.retestText}}</view><view class="fact-row meta">关联 {{detail.relatedCount}} 张卡 · 聊天里用过 {{detail.useCount}} 次</view><view wx:if="{{detail.savedAt}}" class="fact-row meta">保存于 {{detail.savedAt}}</view><view class="fact-row" bindtap="toggleTimeline"><text>这张卡的变化</text><text class="chevron">{{timelineOpen?'⌃':'›'}}</text></view><view wx:if="{{timelineOpen}}" class="timeline"><view wx:for="{{detail.versions}}" wx:key="id" class="timeline-item"><text>{{item.date}} · {{item.by==='user'?'我':item.by==='ai'?'AI':'自动'}} · {{item.label}}</text><text wx:if="{{item.text}}" class="timeline-copy">{{item.text}}</text></view><text wx:if="{{!detail.versions.length}}" class="meta">还没有更多记录</text></view></view>

    <view wx:if="{{edit}}" class="mask"><view class="pop editor" catchtap="noop"><view class="pop-top"><text class="h3">编辑</text><text class="close" bindtap="cancelEdit">算了</text></view><text class="field-label">标题</text><input class="field" maxlength="16" value="{{editor.title}}" data-key="title" bindinput="editInput"/><text class="field-label">一句话说说</text><textarea class="field" fixed maxlength="60" value="{{editor.summary}}" data-key="summary" bindinput="editInput"/><text class="field-label">整理出来的内容</text><view wx:for="{{editor.slots}}" wx:key="key" class="edit-row"><text>{{item.label}}</text><input class="field" maxlength="60" value="{{item.text}}" data-index="{{index}}" bindinput="slotInput"/></view><view class="field-label spread"><text>还没想明白的</text><text wx:if="{{editor.open.length<3}}" class="link" bindtap="addOpen">＋ 加一条</text></view><view wx:for="{{editor.open}}" wx:key="key" class="edit-open"><view class="choice-row small"><button class="choice {{item.cat==='decide'?'on':''}}" data-index="{{index}}" data-cat="decide" bindtap="openCat">要决定</button><button class="choice {{item.cat==='verify'?'on':''}}" data-index="{{index}}" data-cat="verify" bindtap="openCat">要核实</button><button class="btn-text danger small-btn" data-index="{{index}}" bindtap="removeOpen">删掉</button></view><input class="field" maxlength="30" value="{{item.text}}" data-index="{{index}}" bindinput="openInput"/></view><view class="fold-row edit-more {{editMore?'open':''}}" bindtap="toggleEditMore">更多设置</view><block wx:if="{{editMore}}"><text class="field-label">这是一张…</text><view class="choice-row"><button wx:for="{{types}}" wx:key="id" class="choice {{editor.kind===item.id?'on':''}}" data-type="{{item.id}}" bindtap="editType">{{item.name}}</button></view><block wx:if="{{editor.scene!=='mood'}}"><text class="field-label">关于</text><view class="choice-row"><button wx:for="{{scenes}}" wx:key="id" class="choice {{editor.scene===item.id?'on':''}}" data-scene="{{item.id}}" bindtap="sceneChange">{{item.name}}</button></view></block><text class="field-label">属于哪个知识点</text><picker mode="selector" range="{{points}}" range-key="name" bindchange="pointChange"><view class="picker-row">{{editor.pointName}}<text>›</text></view></picker><text class="field-label">下一步</text><input class="field" maxlength="100" value="{{editor.nextIf}}" data-key="nextIf" bindinput="editInput" placeholder="如果……"/><input class="field second" maxlength="100" value="{{editor.nextThen}}" data-key="nextThen" bindinput="editInput" placeholder="就……"/><view class="date-row"><picker mode="date" value="{{editor.nextOn}}" bindchange="nextOnChange"><view class="picker-row">{{editor.nextOn||'哪天（可不选）'}}<text>›</text></view></picker><button wx:if="{{editor.nextOn}}" class="btn-text" bindtap="clearNextOn">不定日子</button></view></block><button class="btn" loading="{{busy}}" bindtap="saveEdit">存下</button></view></view>

    <view wx:if="{{closeOpen}}" class="mask"><view class="pop" catchtap="noop"><view class="pop-top"><text class="h3">想明白了，收好</text><text class="close" bindtap="toggleClose">算了</text></view><text class="small-copy">{{detail.learning ? (card.mine ? '你的话已经写好了，收好这张就行' : '写下关键的一步') : '最后想明白了什么？写一句就好'}}</text><textarea wx:if="{{!detail.learning||!card.mine}}" class="field" fixed maxlength="300" value="{{closeDraft}}" bindinput="closeInput" placeholder="你想明白了什么？"/><button class="btn" loading="{{busy}}" bindtap="submitClose">{{detail.learning&&card.type==='method' ? '用到了这张卡，收好' : '收好'}}</button></view></view>

    <view wx:if="{{example&&!original}}" class="example-bottom"><button class="btn" bindtap="backHome">回到随心记</button></view>
    <view wx:elif="{{!example}}" class="bottom-bar"><view class="tb {{card.favorite ? 'on' : ''}}" bindtap="toggleFavorite"><view class="dk {{card.favorite ? 'dk-star' : 'dk-star-o'}}"/><text>{{card.favorite ? '已收藏' : '收藏'}}</text></view><view wx:if="{{!card.crisis&&card.scene!=='mood'}}" class="tb" bindtap="teach"><view class="dk dk-target"/><text>讲一遍</text></view><view class="tb" bindtap="openActions"><view class="dk dk-more"/><text>更多</text></view><button wx:if="{{!card.crisis}}" class="btn" bindtap="chat">接着聊</button></view>
  </block>
</view>
