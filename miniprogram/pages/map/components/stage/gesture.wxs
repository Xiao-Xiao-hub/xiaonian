  target.removeClass("far"); target.removeClass("mid"); target.removeClass("near");
  target.addClass(level(state.s));
}
function parseMotion(value) {
  var parts = (value || "").split(",");
  return { tx: number(parts[0], 0), ty: number(parts[1], 0), s: Math.max(0.2, Math.min(1, number(parts[2], 0.72))) };
}
function motionChanged(value, oldValue, owner) {
  var state = stateFor(owner);
  var parsed = parseMotion(value);
  state.tx = parsed.tx; state.ty = parsed.ty; state.s = parsed.s;
