function stateFor(owner) {
  var local = owner.getState();
  if (!local.motion) local.motion = { tx: 0, ty: 0, s: 0.72, moved: false, startX: 0, startY: 0, startTx: 0, startTy: 0, distance: 0, centerX: 0, centerY: 0, lastX: 0, lastY: 0, lastTime: 0, vx: 0, vy: 0, pinching: false };
  return local.motion;
}

function number(value, fallback) {
  var n = parseFloat(value);
  return isNaN(n) ? fallback : n;
}
// Two levels (D110): stars below 0.66 (pages/map/stars.js SPLIT), cards from there.
function level(s) { return s < 0.66 ? "far" : "near"; }
function plane(instance) { return instance.selectComponent(".map-plane"); }
function render(instance, transition) {
  var state = stateFor(instance);
  var target = plane(instance);
  if (!target) return;
  target.setStyle({
    transform: "translate(" + state.tx + "px," + state.ty + "px) scale(" + state.s + ")",
    transition: transition ? "transform .22s ease-out" : "none"
