.page { padding:28rpx 32rpx; }.lead { display:block; margin:0 4rpx 24rpx; color:var(--body); font-size:28rpx; line-height:1.6; }.panel { background:var(--card); border:2rpx solid var(--line); border-radius:28rpx; padding:12rpx 28rpx; margin-bottom:24rpx; }.row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:24rpx 0; color:var(--ink); font-size:28rpx; border-bottom:2rpx solid var(--rule); }.row:last-child { border:0; }.row text:last-child { color:var(--pencil); }.modes,.days { display:flex; gap:12rpx; padding:16rpx 0; }.choice { display:flex; align-items:center; justify-content:center; flex:1; margin:0; padding:10rpx 8rpx; min-height:64rpx; background:var(--bg); border-radius:16rpx; font-size:26rpx; line-height:1.5; color:var(--body); text-align:center; }.choice::after { border:0; }.selected { color:var(--primary); background:var(--primary-wash); }.days .choice { padding:10rpx 4rpx; }.error { color:var(--red); font-size:26rpx; }
