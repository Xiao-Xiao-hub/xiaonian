<view class="page"><view class="head"><text class="h1">订单详情</text></view><view wx:if="{{loading}}" class="working">正在加载…</view><view wx:if="{{error}}" class="alert">{{error}}</view><view wx:if="{{order}}" class="sheet"><text class="status">{{order.statusText}}</text><text class="h2">{{order.name}}</text><view class="line"><text>{{order.paid ? '支付金额' : '订单金额'}}</text><text class="amount">{{order.price}}</text></view><view class="line"><text>创建时间</text><text>{{order.dateLabel}}</text></view><view class="line"><text>订单号</text><text class="order-id" selectable="{{true}}">{{order.id}}</text></view><text wx:if="{{order.status === 'created'}}" class="hint">尚未确认到账。如已付款，请稍候刷新，无需重复购买。</text><text wx:if="{{order.status === 'delivered'}}" class="hint">权益已到账，可返回额度中心查看。</text><text wx:if="{{order.status === 'refunding'}}" class="hint">退款处理中，对应权益已暂停使用。</text><button class="btn" disabled="{{syncing}}" bindtap="refresh">{{syncing ? '正在刷新…' : '刷新订单状态'}}</button><button class="btn secondary" bindtap="openSupport">订单遇到问题</button></view></view>