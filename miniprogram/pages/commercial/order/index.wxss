.status{display:block;color:var(--primary-ink);font-size:26rpx;margin-bottom:16rpx}.line{display:flex;justify-content:space-between;align-items:baseline;gap:28rpx;padding:22rpx 0;border-bottom:1rpx solid var(--line);font-size:26rpx}.line>text:first-child{color:var(--pencil);white-space:nowrap}.amount{font-size:40rpx;font-weight:700}.order-id{font-size:24rpx;word-break:break-all;text-align:right}.sheet>.hint{margin-top:24rpx;display:block}