<view class="page"><view class="head"><text class="h1">订单记录</text><text class="hint">购买、到账与退款进度</text></view><view wx:if="{{loading}}" class="working">正在加载…</view><view wx:if="{{error}}" class="alert">{{error}}<button class="btn-line" bindtap="load">重新加载</button></view><view wx:if="{{!loading && !error && !orders.length}}" class="sheet center"><text class="h3">还没有订单</text><text class="hint">发起购买后，订单会显示在这里</text></view><view class="rows"><view wx:for="{{orders}}" wx:key="id" class="item" data-id="{{item.id}}" bindtap="open"><view class="copy"><text class="title">{{item.name}}</text><text class="meta">{{item.dateLabel}} · {{item.statusText}}</text></view><text class="order-price">{{item.price}}</text><text class="chevron">›</text></view></view></view>