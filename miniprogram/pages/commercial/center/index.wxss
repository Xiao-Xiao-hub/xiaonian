.commercial{padding-bottom:200rpx}.hero{position:relative;display:flex;align-items:center;min-height:210rpx;padding:22rpx 0 26rpx}.hero-copy{position:relative;z-index:1;max-width:530rpx}.eyebrow{display:block;color:var(--pencil);font-size:24rpx;margin-bottom:12rpx}.hero-title{display:block;font-size:44rpx;line-height:1.35;letter-spacing:-1rpx;font-weight:750;max-width:420rpx}.blue{display:block;color:var(--primary-ink)}.hero-note{display:block;margin-top:18rpx;font-size:24rpx;color:var(--pencil)}.hi{position:absolute;width:176rpx;height:186rpx;right:-12rpx;top:24rpx}.quota-strip{display:flex;align-items:center;gap:32rpx;padding:24rpx 28rpx;background:var(--card);border-radius:24rpx;margin-bottom:28rpx}.quota-label{display:block;font-size:24rpx;color:var(--pencil)}.quota-value{font-size:40rpx;line-height:1.3;font-weight:700;display:block;margin-top:6rpx}.unit{font-size:26rpx;margin-left:4rpx}.quota-week{flex:1;padding-left:28rpx;border-left:1rpx solid var(--line)}.track{height:8rpx;margin-top:16rpx;background:var(--track);border-radius:8rpx;overflow:hidden}.track view{height:100%;background:var(--primary);border-radius:8rpx}.active-plan{padding:22rpx 28rpx;border:1rpx solid var(--primary-soft);border-radius:24rpx;margin-bottom:24rpx;background:var(--primary-wash)}.active-heading{display:flex;justify-content:space-between;font-size:26rpx;font-weight:600}.detail{display:block;font-size:24rpx;color:var(--pencil);margin-top:10rpx}.tabs{display:flex;background:var(--track);padding:6rpx;border-radius:20rpx;gap:4rpx;margin:12rpx 0 28rpx}.tab{flex:1;text-align:center;padding:16rpx 8rpx;font-weight:600;color:var(--pencil);font-size:28rpx;border-radius:16rpx}.tab.on{background:var(--card);color:var(--primary-ink);box-shadow:0 2rpx 8rpx rgba(20,30,60,.07)}.section-heading{display:flex;align-items:baseline;justify-content:space-between;margin:0 2rpx 18rpx;font-size:28rpx;font-weight:600}.section-note{font-size:24rpx;font-weight:400;color:var(--pencil)}.goods{display:flex;flex-direction:column;gap:18rpx}.good{padding:28rpx 30rpx;background:var(--card);border:2rpx solid var(--line);border-radius:28rpx;color:var(--ink)}.good.selected{background:var(--primary-fill);color:var(--on-primary);border-color:var(--primary);box-shadow:0 12rpx 30rpx rgba(47,107,246,.16)}.good-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.good-name{display:block;font-size:34rpx;font-weight:700;line-height:1.35}.good-description{display:block;font-size:24rpx;margin-top:6rpx;color:var(--pencil)}.good-price{display:flex;flex-direction:column;text-align:right;white-space:nowrap;font-size:40rpx;font-weight:700;line-height:1.2}.price-period{font-size:24rpx;font-weight:400;color:var(--pencil);margin-top:8rpx}.good-bottom{display:flex;align-items:center;justify-content:space-between;gap:12rpx;border-top:1rpx solid var(--line);margin-top:22rpx;padding-top:18rpx}.benefit{font-size:32rpx;font-weight:700;color:var(--primary-ink)}.benefit-note{font-weight:400;font-size:24rpx;margin-left:12rpx;color:var(--pencil)}.comparison{display:block;font-size:24rpx;margin-top:4rpx;color:var(--pencil)}.selected .good-description,.selected .price-period,.selected .benefit-note,.selected .comparison{color:rgba(255,255,255,.9)}.selected .benefit{color:white}.selected .good-bottom{border-top-color:rgba(255,255,255,.2)}.selection{flex-shrink:0;border:2rpx solid var(--line-strong);width:32rpx;height:32rpx;line-height:32rpx;text-align:center;border-radius:50%;font-size:24rpx}.selected .selection{background:white;color:var(--primary-ink);border-color:white}.platform-note{display:block;font-size:24rpx;color:var(--pencil);margin:20rpx 4rpx 28rpx}.wallet{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:24rpx 28rpx;background:var(--primary-wash);border-radius:24rpx;margin-bottom:20rpx}.wallet-label{font-size:24rpx;color:var(--pencil)}.wallet-number{display:block;font-size:44rpx;font-weight:700;line-height:1.4;color:var(--primary-ink)}.wallet-note{font-size:24rpx;color:var(--pencil);max-width:220rpx;text-align:right}.wallet-consent{margin:0;padding:12rpx 18rpx;font-size:24rpx;background:var(--card);color:var(--primary-ink);border-radius:16rpx;line-height:1.5}.more-rows{background:var(--card);border-radius:24rpx;padding:0 26rpx}.more-row{display:flex;justify-content:space-between;gap:20rpx;padding:24rpx 0;font-size:26rpx}.more-row+ .more-row{border-top:1rpx solid var(--line)}.more-row text:last-child{color:var(--pencil);font-size:24rpx}.rules{padding:0 0 24rpx;color:var(--pencil);font-size:24rpx;line-height:1.8}.rules text{display:block;margin-top:12rpx}.bottom{position:fixed;z-index:2;right:0;bottom:0;left:0;padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));background:var(--card);border-top:1rpx solid var(--rule)}.bottom .btn{margin-top:0}.bottom-hint{display:block;margin-top:8rpx;text-align:center;color:var(--pencil);font-size:24rpx}.availability{font-size:26rpx;background:var(--primary-wash);color:var(--primary-ink);padding:22rpx 26rpx;border-radius:24rpx;margin-bottom:24rpx}.error-box{padding:24rpx;background:var(--amber-wash);color:var(--amber-ink);font-size:26rpx;border-radius:20rpx;margin-bottom:24rpx}.text-button{margin:12rpx 0 0;padding:0;line-height:1.8;font-size:26rpx;text-align:left;color:var(--primary-ink);background:transparent}.text-button::after{border:0}.good.blocked{opacity:.5}.good-action{color:var(--primary-ink)}.selected .good-action{color:white}
