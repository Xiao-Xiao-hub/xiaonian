<page-head tint="slate" />
<view class="page ph-body">
  <guest-bar />
  <view class="who">
    <view class="who-l">
      <block wx:if="{{profileMode === 'nickname' && profileReady}}">
        <block wx:for="{{[nicknameInputId]}}" wx:key="*this">
          <input class="who-name nickname-inline" type="nickname" value="{{draftNickname}}" maxlength="24" placeholder="昵称" focus="{{true}}" confirm-type="done" data-edit="{{profileEditId}}" data-input="{{item}}" disabled="{{profileSaving || nicknamePending}}" bindinput="nicknameInput" bindblur="nicknameBlur" bindconfirm="nicknameBlur" bindnicknamereview="nicknameReview" aria-label="修改昵称" />
        </block>
      </block>
      <text wx:else class="who-name" bindtap="editNickname" aria-role="button" aria-label="修改昵称">{{guest ? '游客' : (name || '你好')}}</text>
      <view wx:if="{{learn}}" class="who-tags"><text class="lv">Lv {{learn.level}}</text><text wx:if="{{learn.rank}}">{{learn.rank}}</text><text>高数上</text></view>
    </view>
    <button wx:if="{{!guest}}" class="me-av" hover-class="btn-press" open-type="chooseAvatar" bindtap="beginAvatar" bindchooseavatar="changeAvatar" disabled="{{loading || profileSaving || profileAuthorizing || profileMode === 'nickname'}}" aria-label="修改头像"><image wx:if="{{avatarPath}}" class="avatar-image" src="{{avatarPath}}" mode="aspectFill" binderror="avatarError" /><text wx:else>{{initial || '我'}}</text></button>
    <view wx:else class="me-av"><text>我</text></view>
  </view>
  <view wx:if="{{error}}" class="alert">{{error}}<button wx:if="{{!guest}}" class="retry tap-area" disabled="{{loading || busy}}" bindtap="load">重试</button></view>
  <block wx:if="{{!guest}}">
    <view class="entry2">
      <view class="entry pay" hover-class="entry-press" bindtap="openUsage" aria-role="button" aria-label="充值"><text class="entry-t">充值</text><text class="entry-s">套餐 · 积分</text><image wx:if="{{!broken.gem}}" class="ic3d entry-ic" src="{{icons.gem}}" webp="{{true}}" mode="aspectFit" data-k="gem" binderror="iconError" /></view>
      <view class="entry help" hover-class="entry-press" bindtap="openSupport" aria-role="button" aria-label="客服"><text class="entry-t">客服</text><text class="entry-s">有问题问我</text><image wx:if="{{!broken.headphone}}" class="ic3d entry-ic" src="{{icons.headphone}}" webp="{{true}}" mode="aspectFit" data-k="headphone" binderror="iconError" /></view>
    </view>
    <view wx:if="{{lowUsage}}" class="notice" bindtap="openUsage">{{lowUsage}} ›</view>
    <view wx:if="{{study}}" class="study">
      <view class="st-hd"><text class="st-t">学习时间</text></view>
      <view class="nums">
        <view class="num"><view class="num-v">{{study.total}}</view><text class="num-k">累计学习天数</text></view>
        <view class="num"><view class="num-v">{{study.minutes}}</view><text class="num-k">累计学习分钟</text></view>
        <view class="num"><view class="num-v">{{study.current}}</view><text class="num-k">连续学习天数</text></view>
      </view>
      <view class="heat">
        <text class="st-more heat-t">近 18 周</text>
        <view class="mo"><text wx:for="{{study.months}}" wx:key="index" class="mo-i">{{item}}</text></view>
        <view class="heat-b">
          <view class="wd"><text>一</text><text></text><text>三</text><text></text><text>五</text><text></text><text>日</text></view>
          <view class="cols">
            <view wx:for="{{study.columns}}" wx:for-item="col" wx:for-index="w" wx:key="key" class="col {{picked.w === w ? 'pk' : ''}}" data-w="{{w}}" bindtap="pickWeek" aria-role="button" aria-label="{{col.al}}">
              <view wx:for="{{col.cells}}" wx:for-item="c" wx:key="day" class="hc {{c.fu ? 'fu' : 'l' + c.lv}} {{c.td ? 'td' : ''}}" aria-hidden="true" />
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{picked}}" class="wk">
        <view wx:for="{{picked.days}}" wx:key="k" class="wk-d {{item.td ? 'td' : ''}} {{item.fu ? 'fu' : ''}}" aria-label="{{item.fu ? '周' + item.wd : '周' + item.wd + ' ' + item.min + ' 分钟'}}"><text class="wk-n {{item.min === 0 ? 'z' : ''}}" aria-hidden="true">{{item.min}}</text><text class="wk-w" aria-hidden="true">{{item.wd}}</text></view>
      </view>
      <view class="hfoot">
        <text wx:if="{{picked}}" class="hf-today">{{picked.label}} 共 <text class="hf-b">{{picked.min}}</text> 分钟</text>
        <text wx:else class="hf-today">今天 <text class="hf-b">{{study.todayMin}}</text> 分钟</text>
        <view class="grow" />
        <text>少</text><view class="hk l0" /><view class="hk l1" /><view class="hk l2" /><view class="hk l3" /><view class="hk l4" /><text>多</text>
      </view>
      <view class="st-note">{{study.enabled ? '只给自己看，不排行，不和别人比。' : '学习时长统计关着，不记新的时长。'}}</view>
    </view>
    <view class="stats">
      <view class="sc" bindtap="openCards"><image wx:if="{{!broken.cards}}" class="ic3d sc-ic" src="{{icons.cards}}" webp="{{true}}" mode="aspectFit" data-k="cards" binderror="iconError" /><view><text class="sc-v">{{stats ? stats.total : '—'}}</text><text class="sc-k">张卡片</text></view></view>
      <view class="sc"><image wx:if="{{!broken.star}}" class="ic3d sc-ic" src="{{icons.star}}" webp="{{true}}" mode="aspectFit" data-k="star" binderror="iconError" /><view><text class="sc-v">{{learn ? learn.correct : '—'}}</text><text class="sc-k">个知识点做对</text></view></view>
      <view class="sc"><image wx:if="{{!broken.medal}}" class="ic3d sc-ic" src="{{icons.medal}}" webp="{{true}}" mode="aspectFit" data-k="medal" binderror="iconError" /><view><text class="sc-v">{{learn ? learn.xp : '—'}}</text><text class="sc-k">经验</text></view></view>
    </view>
    <view class="tiles2">
      <view class="ftile yellow" bindtap="openMoodLog"><text class="t">心情记录</text><text class="s">只给自己看</text><image wx:if="{{!broken.mood}}" class="ic3d" src="{{icons.mood}}" webp="{{true}}" mode="aspectFit" data-k="mood" binderror="iconError" /></view>
    </view>
    <view class="icons">
      <view class="ic" bindtap="openTags"><view class="ic-bg"><image wx:if="{{!broken.tags}}" class="ic3d ic-i" src="{{icons.tags}}" webp="{{true}}" mode="aspectFit" data-k="tags" binderror="iconError" /></view><text>标签</text></view>
      <view class="ic" bindtap="openResume"><view class="ic-bg"><image wx:if="{{!broken.resume}}" class="ic3d ic-i" src="{{icons.resume}}" webp="{{true}}" mode="aspectFit" data-k="resume" binderror="iconError" /></view><text>提醒</text></view>
      <view class="ic" bindtap="exportData"><view class="ic-bg"><image wx:if="{{!broken.export}}" class="ic3d ic-i" src="{{icons.export}}" webp="{{true}}" mode="aspectFit" data-k="export" binderror="iconError" /></view><text>{{exporting ? '准备中…' : '导出'}}</text></view>
      <view class="ic" bindtap="openHelp"><view class="ic-bg"><image wx:if="{{!broken.help}}" class="ic3d ic-i" src="{{icons.help}}" webp="{{true}}" mode="aspectFit" data-k="help" binderror="iconError" /></view><text>帮助</text></view>
    </view>
    <view class="menu list">
      <view class="li"><text class="li-l">聊天时推荐相关的卡</text><switch checked="{{suggestCards}}" disabled="{{prefBusy || loading}}" bindchange="toggleSuggest" color="#2459d8"/></view>
      <view class="li"><text class="li-l">卡片里显示心情卡</text><switch checked="{{showMood}}" bindchange="toggleMood" color="#2459d8"/></view>
      <view wx:if="{{prefs}}" class="li"><text class="li-l">个性化学习推荐</text><switch checked="{{personalized}}" disabled="{{prefBusy || loading}}" data-k="personalized" bindchange="togglePref" color="#2459d8"/></view>
      <view wx:if="{{prefs}}" class="li"><text class="li-l">学习时长统计</text><switch checked="{{studyTime}}" disabled="{{prefBusy || loading}}" data-k="studyTime" bindchange="togglePref" color="#2459d8"/></view>
      <view class="li" bindtap="toggleUsage"><text class="li-l">{{budget ? '额度' : '今天还能用'}}</text><text wx:if="{{budget}}" class="li-v">{{budget}}</text><text wx:elif="{{left !== null}}" class="li-v">还剩 {{left}} 次</text><text class="chev {{usageOpen?'turned':''}}">›</text></view>
      <view class="li" bindtap="openPrivacy"><text class="li-l">隐私政策</text><text class="chev">›</text></view>
      <view wx:if="{{study}}" class="li" bindtap="deleteStudyTime"><text class="li-l danger">删除学习时长记录</text><text class="chev">›</text></view>
    </view>
    <view class="bye" bindtap="deleteAccount">注销账号</view>
  </block>
  <view wx:else class="menu list">
    <view class="li" bindtap="openHelp"><text class="li-l">帮助</text><text class="chev">›</text></view>
    <view class="li" bindtap="openPrivacy"><text class="li-l">隐私政策</text><text class="chev">›</text></view>
  </view>
</view>
